meta(property="twitter:url" content=pageUrl ? pageUrl : "https://teklynktools.com")
meta(property="twitter:domain" content="teklynktools.com")

//- Titles (og + twitter)
meta(property="og:title" content=title ? title : "Teklynk Tools")
