header.sticky-top#topNav
    a.visually-hidden-focusable(href="#main") Skip to main content
    .container-fluid.g-0
        nav.navbar.navbar-expand-lg.bg-dark#nav-main
            .container
                a.navbar-brand.text-white(href="/" aria-current=page === "home" ? "page" : null) Teklynk Tools
                button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#navbarNavDropdown", aria-controls="navbarNavDropdown", aria-expanded="false", aria-label="Toggle navigation")
                    span.navbar-toggler-icon.custom-toggler
                .collapse.navbar-collapse#navbarNavDropdown
                    ul.navbar-nav.me-auto
                        li.nav-item
                            a.nav-link(href="/twitch-clips-player" class=page === "clips-player" ? "active" : null aria-current=page === "clips-player" ? "page" : null) Clips Player
                        li.nav-item
                            a.nav-link(href="/twitch-shout-out" class=page === "shout-out" ? "active" : null aria-current=page === "shout-out" ? "page" : null) Shoutouts
                        li.nav-item
                            a.nav-link(href="/twitch-chat-emotes" class=page === "chat-emotes" ? "active" : null aria-current=page === "chat-emotes" ? "page" : null) Emotes Wall
                        li.nav-item
                            a.nav-link(href="/twitch-chat-overlay" class=page === "chat-overlay" ? "active" : null aria-current=page === "chat-overlay" ? "page" : null) Chat Overlays
                        li.nav-item
                            a.nav-link(href="/support" class=page === "support" ? "active" : null aria-current=page === "support" ? "page" : null) Support
   
                    .d-flex.align-items-center
                        a.btn.btn-outline-light.btn-sm.rounded-pill.fw-bold(href="/discord", target="_self" style='padding-right: 1.25em; padding-left: 1.25em;')
                            i.fa-brands.fa-discord
                            |  Join the Discord