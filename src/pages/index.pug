extends ../layout/index-layout.pug

block title
    - var date = ""
    - var title = ""
    - var description = ""
    - var thumbnail = ""
    - var pageUrl = "https://teklynktools.com"
    - var skills = []
    | Teklynk Tools - Twitch Overlays for OBS & Streamlabs

block content
    section.hero-section
        .container.py-5
            .row.align-items-center.g-5
                .col-lg-6
                    h1.display-4.fw-bold
                        | Browser-source overlays for Twitch streamers
                    p.lead
                        | 44K+ weekly uses. No account required.
                    p
                        | Clips player, emotes wall, shoutouts, and more.
                    p
                        | Pick a theme, add a URL, you're done.

                    .d-flex.flex-wrap.gap-3.mt-4
                        a.btn.btn-primary.btn-lg.rounded-pill(href="#tools") Explore tools
                    ul.list-unstyled.mt-4.mb-0
                        li
                            i.fa-solid.fa-check.text-success.me-2
                            | Chat engagement
                        li
                            i.fa-solid.fa-check.text-success.me-2
                            | Community promotion
                        li
                            i.fa-solid.fa-check.text-success.me-2
                            | Custom styling

                .col-lg-6
                    .hero-panel.panel-shadow
                        .panel-header
                            span.dot
                            span.dot
                            span.dot
                        .panel-body
                            .mini-card
                                .small Weekly usage
                                .text-white.fs-4.fw-bold 44K+ weekly stream tool uses
                            .mini-chart
                                .bar(style="height: 36%")
                                .bar(style="height: 52%")
                                .bar(style="height: 68%")
                                .bar(style="height: 82%")
                                .bar(style="height: 100%")
                            .row.g-3.mt-3
                                .col-6
                                    .stat-card
                                        .small Shoutouts
                                        .text-white.fs-4.fw-bold 30K+
                                .col-6
                                    .stat-card
                                        .small Clips
                                        .text-white.fs-4.fw-bold 14K+

    section.band
        .container.py-5
            .row.g-4.text-center
                .col-lg-3.col-md-6
                    .feature-pill
                        i.fs-4.fa-solid.fa-clapperboard
                        span.fs-4 Clips Player
                .col-lg-3.col-md-6
                    .feature-pill
                        i.fs-4.fa-solid.fa-face-smile
                        span.fs-4 Emotes Wall
                .col-lg-3.col-md-6
                    .feature-pill
                        i.fs-4.fa-solid.fa-bullhorn
                        span.fs-4 Shoutouts
                .col-lg-3.col-md-6
                    .feature-pill
                        i.fs-4.fa-solid.fa-comment
                        span.fs-4 Chat Overlays

    section#tools
        .container.py-5
            .row.align-items-center.g-5
                .col-lg-5
                    .section-copy
                        span.section-kicker Twitch tools
                        h2 What these tools do
                        p
                            | Starting Soon scenes that aren't static. BRB transitions that keep viewers watching. Chat emotes visible to everyone on stream. Shoutouts that promote other creators. Overlays that can be customized for your needs.
                
                    .detail-panel.h-100
                        h3 Demo video
                        .mt-3
                            iframe#odysee-iframe.border.rounded.shadow-lg(
                                style="width:100%; aspect-ratio:16 / 9;"
                                src="https://odysee.com/%24/embed/%40teklynk%3Ac%2Fteklynktools-clipsplayer-demo%3A5?r=6kei5PPCVaPWL5HURU9aAyq2KXEoE6ki"
                                allowfullscreen
                            )
                
                .col-lg-7
                    .row.g-4
                        .col-md-6
                            .feature-card.position-relative
                                .feature-icon
                                    i.fs-1.fa-solid.fa-clapperboard
                                h3 Twitch Clips Player
                                p
                                    | Plays clips from your channel or channels you follow in a loop on your Starting Soon or BRB scene. Filter by date range, pick a theme, and add a details panel showing who made the clip.
                                p
                                    small
                                        | Works in OBS, Moblin, Streamlabs as a browser source. Supports custom CSS, themes, and chat commands.
                                p
                                    small.muted
                                        | Click for more details 
                                a.stretched-link(href="/twitch-clips-player")

                        .col-md-6
                            .feature-card.position-relative
                                .feature-icon
                                    i.fs-1.fa-solid.fa-bullhorn
                                h3 Twitch Shoutout
                                p
                                    | Promote other streamers by playing a clip from various streamers, chat-controlled shout-out actions with "!so @username".
                                p
                                    small
                                        | Helps community growth and creator visibility.
                                p
                                    small
                                        | Works in OBS, Moblin, Streamlabs as a browser source. Supports custom CSS, themes, and chat commands.
                                p
                                    small.muted
                                        | Click for more details 
                                a.stretched-link(href="/twitch-shout-out")

                        .col-md-6
                            .feature-card.position-relative
                                .feature-icon
                                    i.fs-1.fa-solid.fa-face-smile
                                h3 Twitch Chat Emotes Wall
                                p
                                    | Animated overlay that turns chat emotes into a floating wall of reactions for your stream.
                                p
                                    small
                                        | Supports Twitch, BetterTTV, 7TV, and FrankerFaceZ emotes.
                                p
                                    small
                                        | Works in OBS, Moblin, Streamlabs as a browser source. No account required.
                                p
                                    small.muted
                                        | Click for more details 
                                a.stretched-link(href="/twitch-chat-emotes")

                        .col-md-6
                            .feature-card.position-relative
                                .feature-icon
                                    i.fs-1.fa-solid.fa-comment
                                h3 Twitch Chat Overlay
                                p
                                    | Display live chat on your stream with customizable themes. Choose from built-in styles, enable third-party emotes, and set how many messages show.
                                p
                                    small       
                                        | Change themes, emotes support, badges and other preferences via URL.
                                p
                                    small
                                        | Works in OBS, Moblin, Streamlabs as a browser source. No account required. 
                                p
                                    small.muted
                                        | Click for more details 
                                a.stretched-link(href="/twitch-chat-overlay")

    section.band.d-none(aria-labelledby="testimonials-heading")
        .container.py-5
            .d-flex.flex-wrap.justify-content-between.align-items-end.gap-3.mb-4
                div
                    h2#testimonials-heading.mb-0 What Are the Users Saying?

            #streamerTestimonials.carousel.slide.carousel-fade.panel-shadow(data-bs-ride="carousel" data-bs-interval="6000" aria-label="Streamer testimonials")
                .carousel-indicators
                    button(data-bs-target="#streamerTestimonials" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1")
                    button(data-bs-target="#streamerTestimonials" data-bs-slide-to="1" aria-label="Slide 2")
                    button(data-bs-target="#streamerTestimonials" data-bs-slide-to="2" aria-label="Slide 3")
                    button(data-bs-target="#streamerTestimonials" data-bs-slide-to="3" aria-label="Slide 4")
                .carousel-inner
                    .carousel-item.active
                        article.testimonial-slide
                            a.testimonial-profile(href="https://www.twitch.tv/artyomhavok?utm_source=teklynktools.com_testimonial" target="_blank" rel="noopener noreferrer" aria-label="Visit artyomhavok on Twitch")
                                img.img-rounded(src="https://static-cdn.jtvnw.net/jtv_user_pictures/17784a06-82a1-4181-8714-583c5c7b774d-profile_image-300x300.png", alt="ArtyomHavok avatar")
                            .testimonial-copy
                                blockquote
                                    p.mb-3 The clips player gave my Starting Soon scene a little more life, and setup was refreshingly simple.
                                .testimonial-attribution
                                    a(href="https://www.twitch.tv/artyomhavok?utm_source=teklynktools.com_testimonial" target="_blank" rel="noopener noreferrer" aria-label="Visit artyomhavok on Twitch")
                                        strong ArtyomHavok
                                    small.d-block.muted Streamer

                    .carousel-item
                        article.testimonial-slide
                            a.testimonial-profile(href="https://www.twitch.tv/radgryd?utm_source=teklynktools.com_testimonial" target="_blank" rel="noopener noreferrer" aria-label="Visit Radgryd on Twitch")
                                img.img-rounded(src="https://static-cdn.jtvnw.net/jtv_user_pictures/e958588c-f901-4e81-b29a-f5023de115dc-profile_image-300x300.png", alt="Radgryd avatar")
                            .testimonial-copy
                                blockquote
                                    p.mb-3 Teklynk builds for the community. The tools he provides make streams more interactive and help streamers connect with their audience. You'd be a fool not to try them. 😏
                                .testimonial-attribution
                                    a(href="https://www.twitch.tv/radgryd?utm_source=teklynktools.com_testimonial" target="_blank" rel="noopener noreferrer" aria-label="Visit Radgryd on Twitch")
                                        strong Radgryd
                                    small.d-block.muted Streamer

                    .carousel-item
                        article.testimonial-slide
                            a.testimonial-profile(href="https://www.twitch.tv/ladygamega?utm_source=teklynktools.com_testimonial" target="_blank" rel="noopener noreferrer" aria-label="Visit LadyGameGa on Twitch")
                                img.img-rounded(src="https://static-cdn.jtvnw.net/jtv_user_pictures/8788ab3c-c5bc-4d55-aa13-5ef9e57f71e1-profile_image-300x300.png", alt="LadyGameGa avatar")
                            .testimonial-copy
                                blockquote
                                    p.mb-3 Teklynk builds for the community. The tools he provides make streams more interactive and help streamers connect with their audience. You'd be a fool not to try them. 😏
                                .testimonial-attribution
                                    a(href="https://www.twitch.tv/ladygamega?utm_source=teklynktools.com_testimonial" target="_blank" rel="noopener noreferrer" aria-label="Visit LadyGameGa on Twitch")
                                        strong LadyGameGa
                                    small.d-block.muted Streamer

                    .carousel-item
                        article.testimonial-slide
                            a.testimonial-profile(href="https://www.twitch.tv/techier0b?utm_source=teklynktools.com_testimonial" target="_blank" rel="noopener noreferrer" aria-label="Visit techieR0b on Twitch")
                                img.img-rounded(src="https://static-cdn.jtvnw.net/jtv_user_pictures/7658100b-2058-41f3-aa47-f1274bb256e9-profile_image-300x300.png", alt="techieR0b avatar")
                            .testimonial-copy
                                blockquote
                                    p.mb-3 The shoutout tool makes it easy to celebrate other creators and share their clips with my community.
                                .testimonial-attribution
                                    a(href="https://www.twitch.tv/techier0b?utm_source=teklynktools.com_testimonial" target="_blank" rel="noopener noreferrer" aria-label="Visit techieR0b on Twitch")
                                        strong techieR0b
                                    small.d-block.muted Streamer

                button.carousel-control-prev(type="button" data-bs-target="#streamerTestimonials" data-bs-slide="prev" aria-label="Previous testimonial")
                    span.carousel-control-prev-icon(aria-hidden="true")
                button.carousel-control-next(type="button" data-bs-target="#streamerTestimonials" data-bs-slide="next" aria-label="Next testimonial")
                    span.carousel-control-next-icon(aria-hidden="true")

    section
        .container.py-5
            .row.g-4.align-items-stretch
                .col-lg-6
                    .cta-panel.panel-shadow
                        h3 These are open-source tools. You can inspect, fork, or contribute
                        p
                            | Every project lives on GitHub with public issue tracking. Report bugs, suggest features, or browse existing discussions to see how other streamers use these overlays

                        ul.list-unstyled.mt-4.mb-0
                            li
                                i.fa-solid.fa-check.text-success.me-2
                                | GitHub Issues for bug reports and feature requests
                            li
                                i.fa-solid.fa-check.text-success.me-2
                                | GitHub Discussions for tips, tricks, and community support
                            li
                                i.fa-solid.fa-check.text-success.me-2
                                | Documented setup and configuration guides
                            li
                                i.fa-solid.fa-check.text-success.me-2
                                | Quick turnaround on reported issues

                .col-lg-6
                    .cta-panel.panel-shadow
                        h3 Built by a single developer
                        .developer-bio
                            img.img-rounded.developer-profile(src="/assets/images/teklynk-profile.jpg", alt="Teklynk developer")
                            .developer-bio-copy
                                p
                                    | I'm not a streamer — I'm just a fan. I enjoy watching Twitch and wanted to build tools that help new and existing streamers. These tools grew from curiosity into something thousands of streamers use.
                                p
                                    | Authenticity over production value, technical honesty over marketing fluff. Have fun, be creative, Enjoy!
                        ul.list-inline
                            .list-inline-item.badge.bg-secondary-dark.p-2.m-1.fs-6 Developer built
                            .list-inline-item.badge.bg-secondary-dark.p-2.m-1.fs-6 Community grown
                            .list-inline-item.badge.bg-secondary-dark.p-2.m-1.fs-6 User feedback driven
