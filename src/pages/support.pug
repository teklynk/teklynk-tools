extends ../layout/page-layout.pug

block title
    - var page = "support"
    - var date = ""
    - var title = ""
    - var description = ""
    - var thumbnail = ""
    - var pageUrl = "https://teklynktools.com/support"
    - var skills = []
    | Teklynk Tools - Support

block content
    .product-detail-page
        section.product-detail-hero
            .container.py-5

                span.section-kicker Support
                p.lead 
                    | If you enjoy some of the projects that I have developed, please consider donating. It helps support the online infrastructure that powers these projects.

                .row.row-cols-1.row-cols-md-2.row-cols-lg-4.g-4.mt-3
                    .col
                        .text-center.feature-card.position-relative
                            .d-flex.flex-column.justify-content-center.align-items-center
                                i.fa-solid.fa-mug-hot.fa-3x.mb-3.text-danger
                                h5 Support me on Ko-fi
                                a.stretched-link(href="https://ko-fi.com/teklynk", target="_blank", rel="noopener noreferrer")
                    .col
                        .text-center.feature-card.position-relative
                            .d-flex.flex-column.justify-content-center.align-items-center
                                i.fa-brands.fa-github.fa-3x.mb-3.text-white
                                h5 Support me on GitHub
                                a.stretched-link(href="https://github.com/sponsors/teklynk", target="_blank", rel="noopener noreferrer")
                    .col
                        .text-center.feature-card.position-relative
                            .d-flex.flex-column.justify-content-center.align-items-center
                                i.fa-solid.fa-hand-holding-heart.fa-3x.mb-3.text-warning
                                h5 Support me on Liberapay
                                a.stretched-link(href="https://liberapay.com/teklynkliberapay/donate", target="_blank", rel="noopener noreferrer")
                    .col
                        .text-center.feature-card.position-relative
                            .d-flex.flex-column.justify-content-center.align-items-center
                                i.fa-brands.fa-paypal.fa-3x.mb-3.text-primary
                                h5 Support me on PayPal
                                a.stretched-link(href="https://www.paypal.com/donate/?hosted_button_id=UVKZUYFMXQDPL", target="_blank", rel="noopener noreferrer")

                .mt-5
                    h2 Other ways to support

                    h3 Give these projects a star on GitHub
                    p If you have used some of my projects, please consider giving them a star on GitHub. It helps me know that people are using my tools and it helps others find them. #[a(href="https://github.com/teklynk", target="_blank", rel="noopener noreferrer") Visit my GitHub profile.]

                    h3 Share a testimonial
                    p A one-sentence testimonial helps build credibility. If you have used my tools, send me a short statement about your experience and I will add it to the website. #[a(href="/contact") Contact me with your testimonial.]

                    h3 Join the GitHub discussions to help others. 
                    ul
                        li Post screenshots of your Twitch overlays.
                        li Answer questions from other users about my tools.
                        li Share your ideas for new features or improvements.
                        li Share your experience with other tools and how my tools compare.
                    p #[a(href="https://github.com/teklynk/twitch_shoutout/discussions", target="_blank", rel="noopener noreferrer") Shoutout Player GitHub discussions] | #[a(href="https://github.com/teklynk/twitch_clips_player/discussions", target="_blank", rel="noopener noreferrer") Clips Player GitHub discussions]